# Raw-boundary fixtures pair one valid source module with concrete raw IR
# values. They do not ask the fuzzer to generate arbitrary raw sum layouts.
seeds {
  seed_id: "raw_boundary_valid_enum_payload"
  surfaces: SEMANTIC_SUM_SEED_SURFACE_RAW_BOUNDARY
  surfaces: SEMANTIC_SUM_SEED_SURFACE_SOURCE
  relative_path: "raw_boundary/enum_payload_sum_module.x"
  outcome: SEMANTIC_SUM_SEED_OUTCOME_SHOULD_PASS
  sample_args: "(bits[2]:0x1, (bits[2]:0x1, bits[16]:0x0))"
  raw_ir_value_text: "(bits[2]:0x1, (bits[2]:0x1, bits[16]:0x0))"
}
seeds {
  seed_id: "raw_boundary_non_member_enum_payload"
  surfaces: SEMANTIC_SUM_SEED_SURFACE_RAW_BOUNDARY
  relative_path: "raw_boundary/enum_payload_sum_module.x"
  outcome: SEMANTIC_SUM_SEED_OUTCOME_SHOULD_FAIL
  expected_diagnostic_substr: "declared member"
  raw_ir_value_text: "(bits[2]:0x1, (bits[2]:0x2, bits[16]:0x0))"
}
