# Reviewed semantic-sum corpus shared by deterministic replay tests.
#
# relative_path is rooted next to this manifest. surfaces selects the replay
# consumers; list more than one surface only when the same outcome applies to
# each consumer. outcome and expected_diagnostic_substr describe deterministic
# replay, while sample_args and raw_ir_value_text provide concrete replay input
# when a consumer needs more than the DSLX source file.
#
# This manifest is not a FUZZ_TEST input domain. Generated FUZZ_TEST cases live
# in each test's explicit domains; this file preserves named reviewed
# regressions that should remain stable as later sum semantics land.
#
# Source fixtures exercise parsing, typechecking, conversion, and sample replay
# through the ordinary DSLX source path.
# Exact constructor-only exhaustive match shape from the IR-converter
# regression.
seeds {
  seed_id: "source_exhaustive_constructor_match_without_wildcard"
  surfaces: SEMANTIC_SUM_SEED_SURFACE_SOURCE
  relative_path: "source/exhaustive_constructor_match_without_wildcard.x"
  outcome: SEMANTIC_SUM_SEED_OUTCOME_SHOULD_PASS
}
